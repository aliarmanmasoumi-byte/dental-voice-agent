    {
      "parameters": {
        "jsCode": "const DOCTORS = {\n  'dr-masoud': { name: 'Dr. Masoud', specialty: 'General Dentistry', calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-paria':  { name: 'Dr. Paria',  specialty: 'Orthodontics',      calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-parvin': { name: 'Dr. Parvin', specialty: 'Endodontics',        calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-ali':    { name: 'Dr. Ali',    specialty: 'Implants',           calendarId: '<GOOGLE_CALENDAR_ID>' }\n};\n\nconst body = $input.first().json.body;\nconst doctorId = (body.doctor_id || '').toLowerCase().trim();\nconst doctor = DOCTORS[doctorId];\n\nif (!doctor) {\n  return [{ json: { error: 'DOCTOR_NOT_FOUND' } }];\n}\n\nif (!body.patient_name || !body.patient_phone || !body.datetime) {\n  return [{ json: { error: 'MISSING_REQUIRED_FIELDS' } }];\n}\n\nlet dtStr = body.datetime;\nif (!dtStr.includes('+') && !dtStr.includes('Z')) dtStr += '+02:00';\n\nconst startDate = new Date(dtStr);\nif (isNaN(startDate.getTime())) {\n  return [{ json: { error: 'INVALID_DATETIME' } }];\n}\n\nconst endDate = new Date(startDate.getTime() + 45 * 60 * 1000);\n\n// Generate appointment ID: CLN-YYYYMMDD-XXXX\nconst d = startDate;\nconst pad = n => String(n).padStart(2, '0');\nconst dateStr = `${d.getUTCFullYear()}${pad(d.getUTCMonth()+1)}${pad(d.getUTCDate())}`;\nconst rand = Math.random().toString(36).substring(2, 6).toUpperCase();\nconst appointmentId = `CLN-${dateStr}-${rand}`;\n\nconst phone = String(body.patient_phone);\nconst phoneLast4 = phone.length >= 4 ? phone.slice(-4) : phone;\n\nreturn [{ json: {\n  appointment_id: appointmentId,\n  patient_name: body.patient_name,\n  patient_phone: phone,\n  phone_last4: phoneLast4,\n  doctor_id: doctorId,\n  doctor_name: doctor.name,\n  specialty: doctor.specialty,\n  calendar_id: doctor.calendarId,\n  datetime_start: dtStr,\n  datetime_end: endDate.toISOString(),\n  notes: body.notes || '',\n  event_summary: `[${appointmentId}] ${body.patient_name}`,\n  event_description: `APPOINTMENT_ID: ${appointmentId}\\nSPECIALTY: ${doctor.specialty}\\nPHONE_LAST4: ${phoneLast4}\\nNOTES: ${body.notes || 'none'}`\n}}];"
      },
