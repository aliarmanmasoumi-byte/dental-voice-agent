    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst phone = String(body.patient_phone || '');\nconst phoneLast4 = phone.length >= 4 ? '***' + phone.slice(-4) : '****';\n\nreturn [{\n  json: {\n    patient_name: body.patient_name || 'Unknown',\n    phone_last4: phoneLast4,\n    full_phone: phone,\n    reason: body.reason || 'No reason provided',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 300],
      "id": "wf6-04-prepare",
      "name": "Prepare Data"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "1erOCc-zeDBkT3yQGwgnzIUJjsLUH_vkVNV65oDUDMbY", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Callback Requests", "mode": "list", "cachedResultName": "Callback Requests" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Patient Name": "={{ $json.patient_name }}",
            "Phone Last 4": "={{ $json.phone_last4 }}",
            "Reason": "={{ $json.reason }}",
            "Status": "pending",
            "Handled At": ""
          }
        },
        "options": { "valueInputMode": "USER_ENTERED" }
      },
      "type": "n8n-nodes-base.googleSheets",
