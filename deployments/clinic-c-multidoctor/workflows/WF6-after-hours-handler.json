          "id": "RECONNECT_SHEETS",
          "name": "Google Sheets - Masoumi"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "<OWNER_EMAIL>",
        "subject": "[Masoumi Clinic] After-Hours Callback Request",
        "emailType": "text",
        "message": "=New callback request received after hours.\n\nPatient: {{ $('Prepare Data').item.json.patient_name }}\nPhone: {{ $('Prepare Data').item.json.full_phone }}\nReason: {{ $('Prepare Data').item.json.reason }}\nTime: {{ $('Prepare Data').item.json.timestamp }}\n\nPlease follow up during working hours (Mon-Thu 10:00-20:00, Fri 10:00-15:00)."
      },
