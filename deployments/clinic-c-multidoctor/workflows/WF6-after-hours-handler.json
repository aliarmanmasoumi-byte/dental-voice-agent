          "name": "Gmail - Masoumi"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"success\",\"message\":\"Callback request registered. The clinic will contact you during working hours: Monday to Thursday 10:00-20:00, Friday 10:00-15:00.\",\"message_es\":\"Solicitud de devolucion de llamada registrada. La clinica se pondra en contacto durante el horario de apertura: lunes a jueves 10:00-20:00, viernes 10:00-15:00.\"}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [300, 300],
