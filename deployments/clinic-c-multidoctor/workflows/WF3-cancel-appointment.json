    {
      "parameters": {
        "jsCode": "const searchData = $('Prepare Search').first().json;\nconst events = $input.all();\n\nconst apptId = searchData.appointment_id;\nconst patientName = searchData.patient_name;\n\nconst match = events.find(e => {\n  const summary = e.json.summary || '';\n  if (apptId && summary.includes(apptId)) return true;\n  if (patientName) {\n    const nameLower = patientName.toLowerCase();\n    const summaryLower = summary.toLowerCase();\n    // Match if summary contains the patient name\n    if (nameLower.split(' ').every(part => summaryLower.includes(part))) return true;\n  }\n  return false;\n});\n\nif (!match) {\n  return [{ json: { found: false } }];\n}\n\nreturn [{ json: {\n  found: true,\n  event_id: match.json.id,\n  event_summary: match.json.summary,\n  event_start: match.json.start?.dateTime || match.json.start?.date,\n  calendar_id: searchData.calendar_id,\n  doctor_name: searchData.doctor_name,\n  patient_name: searchData.patient_name,\n  patient_phone: searchData.patient_phone,\n  appointment_id: apptId || match.json.summary?.match(/\\[([^\\]]+)\\]/)?.[1] || 'unknown'\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [100, 200],
