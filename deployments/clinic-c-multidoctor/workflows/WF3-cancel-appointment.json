    {
      "parameters": {
        "jsCode": "const DOCTORS = {\n  'dr-masoud': { name: 'Dr. Masoud', calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-paria':  { name: 'Dr. Paria',  calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-parvin': { name: 'Dr. Parvin', calendarId: '<GOOGLE_CALENDAR_ID>' },\n  'dr-ali':    { name: 'Dr. Ali',    calendarId: '<GOOGLE_CALENDAR_ID>' }\n};\n\nconst body = $input.first().json.body;\nconst doctorId = (body.doctor_id || '').toLowerCase().trim();\nconst doctor = DOCTORS[doctorId];\n\nif (!doctor) {\n  return [{ json: { error: 'DOCTOR_NOT_FOUND' } }];\n}\n\nconst apptId = body.appointment_id || null;\nconst patientName = body.patient_name || null;\nlet apptDatetime = body.appointment_datetime || null;\n\n// If appointment_id given, extract date from it (CLN-YYYYMMDD-XXXX)\nif (apptId && !apptDatetime) {\n  const match = apptId.match(/CLN-(\\d{4})(\\d{2})(\\d{2})-/);\n  if (match) {\n    apptDatetime = `${match[1]}-${match[2]}-${match[3]}T00:00:00+02:00`;\n  }\n}\n\nif (!apptDatetime && !patientName) {\n  return [{ json: { error: 'MISSING_SEARCH_PARAMS' } }];\n}\n\nif (!apptDatetime.includes('+') && !apptDatetime.includes('Z')) {\n  apptDatetime += '+02:00';\n}\n\nconst searchDate = new Date(apptDatetime);\nconst dayStart = new Date(searchDate);\ndayStart.setUTCHours(0, 0, 0, 0);\nconst dayEnd = new Date(dayStart.getTime() + 24 * 60 * 60 * 1000);\n\nreturn [{ json: {\n  doctor_id: doctorId,\n  doctor_name: doctor.name,\n  calendar_id: doctor.calendarId,\n  appointment_id: apptId,\n  patient_name: patientName,\n  patient_phone: String(body.patient_phone || ''),\n  search_start: dayStart.toISOString(),\n  search_end: dayEnd.toISOString()\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, 300],
