      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [-120, 200],
      "id": "wf3-07-get-events",
      "name": "Get Day Events",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "RECONNECT_CALENDAR",
          "name": "Google Calendar - Masoumi"
        }
      },
      "alwaysOutputData": true
