# Copy to .env and fill in. .env is gitignored.

# --- voice runtime -----------------------------------------------------------
RETELL_API_KEY=
RETELL_KEY=                 # alias read by the deploy and test scripts
RETELL_KEY_OLD=             # the account that still holds the phone number, during a move

# ids of a standing deployment (deploy.mjs writes these to deployed.json)
RETELL_LLM_ID=
RETELL_AGENT_ID=
RETELL_KB_ID=
RETELL_DEPLOYED=            # path to a deployed.json, instead of the three ids above

# --- telephony (the number is ours, not runtime-provisioned) -----------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_SID=
TWILIO_PHONE_SID=
TWILIO_SIP_CRED_LIST=
TWILIO_TERMINATION_URI=     # <subdomain>.pstn.twilio.com
SIP_USERNAME=
CLINIC_PHONE_US=
CLINIC_PHONE_ES=
TRANSFER_NUMBER=            # where the agent hands a caller off to a human

# --- booking backend ---------------------------------------------------------
# Shared secret the agent sends as x-webhook-token; the n8n validation node
# rejects anything without it.
WEBHOOK_TOKEN=
N8N_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=            # waitlist

# --- the test harness --------------------------------------------------------
# Plays the simulated patient and grades the transcript.
OPENAI_API_KEY=
